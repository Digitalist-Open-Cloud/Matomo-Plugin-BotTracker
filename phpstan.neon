parameters:
    level: 5
    phpVersion: 70205
    paths:
        - .
    excludePaths:
        - tests/*
        - github-action-tests (?)
    bootstrapFiles:
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
        - Piwik\Session\SessionNamespace
